# зависимости и сборка
node_modules
dist
*.tsbuildinfo
*.local

# все служебные папки, начинающиеся с точки (.idea, .claude, .agents, .shots …)
.*/
# кроме workflow деплоя — без него не будет автодеплоя на GitHub Pages
!.github/

# файлы, не относящиеся к проекту
.DS_Store
skills-lock.json

# секреты Worker'а для локального запуска
.dev.vars
# секреты (бот Telegram и т.п.) — в git попадают только шаблоны
.env
.env.*
!.env.example
